// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OPD
  BRIDA
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(OPD)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  problems  Problem[]
  researches Research[]
}

enum ProblemStatus {
  DRAFT
  SUBMITTED
  VALID
  REVISION_REQUIRED
  REJECTED
}

model MasterSector {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  problems    Problem[]
}

model Problem {
  id               String        @id @default(uuid())
  title            String
  sectorId         String
  sector           MasterSector  @relation(fields: [sectorId], references: [id])
  targetCompletion String
  background       String
  mainFocus        String
  impact           String
  urgency          String
  attachments      String[]
  status           ProblemStatus @default(SUBMITTED)
  rejectionReason  String?
  createdById      String
  createdBy        User          @relation(fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  researches       Research[]
}

model MasterResearchType {
  id         String     @id @default(uuid())
  name       String     @unique
  researches Research[]
}

enum ResearchStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model Research {
  id                      String             @id @default(uuid())
  problemId               String
  problem                 Problem            @relation(fields: [problemId], references: [id])
  title                   String
  researchTypeId          String
  researchType            MasterResearchType @relation(fields: [researchTypeId], references: [id])
  objective               String
  researchQuestions       String
  scope                   String
  expectedOutput          String
  expectedOutcome         String
  successIndicators       String
  estimatedBudget         Float
  estimatedDurationMonths Int
  status                  ResearchStatus     @default(SUBMITTED)
  createdById             String
  createdBy               User               @relation(fields: [createdById], references: [id])
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  kak                     Kak?
}

model Kak {
  id                String    @id @default(uuid())
  researchId        String    @unique
  research          Research  @relation(fields: [researchId], references: [id], onDelete: Cascade)
  dasarPemikiran    String
  maksudTujuan      String
  ruangLingkup      String
  metodologi        String
  output            String
  outcome           String
  indikatorKinerja  String
  jadwalPelaksanaan String
  penutup           String
  rabItems          RabItem[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model RabItem {
  id          String @id @default(uuid())
  kakId       String
  kak         Kak    @relation(fields: [kakId], references: [id], onDelete: Cascade)
  description String
  volume      Int
  unit        String
  unitPrice   Float
  total       Float
}
