// Prisma Schema untuk SIM-RIDA (Sistem Informasi Riset dan Inovasi Daerah)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN_BRIDA
  KEPALA_BRIDA
  OPD
}

enum ProposalStatus {
  DRAFT
  PENDING
  RETURNED
  IN_REVIEW
  SCORED
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

enum ProposalUrgency {
  TINGGI
  SEDANG
  RENDAH
}

enum ExpectedOutput {
  REKOMENDASI_KEBIJAKAN
  NASKAH_AKADEMIK
  PROTOTIPE_SISTEM
  DOKUMEN_MASTERPLAN
  STUDI_KELAYAKAN
}

enum VerificationDecision {
  PASS
  RETURN
}

enum ResearchField {
  EKONOMI_PEMBANGUNAN
  TATA_KELOLA_PEMERINTAHAN
  SOSIAL_BUDAYA
  INOVASI_TEKNOLOGI
}

enum ExecutionScheme {
  SWAKELOLA
  PENUNJUKAN_LANGSUNG
  E_KATALOG
  TENDER
}

enum PriorityCategory {
  PRIORITAS_UTAMA
  PRIORITAS_KEDUA
  TIDAK_PRIORITAS
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  REVISION_REQUIRED
}

enum StudyStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
}

enum DocumentStatus {
  DRAFT
  FINAL
}

enum RecommendationImpact {
  STRATEGIS_DAERAH
  SEKTORAL
  OPERASIONAL
}

enum RecommendationStatus {
  DRAFT
  SUBMITTED
  FINALIZED
}

enum PolicyTargetType {
  DRAFT_PERBUP
  DRAFT_PERDA
  SE_BUPATI
  SOP_LAYANAN
  RENCANA_AKSI_DAERAH
  PETUNJUK_TEKNIS
}

enum SignedDocumentType {
  POLICY_RECOMMENDATION
  KAK_DOCUMENT
}

enum TteStatus {
  VALID
  REVOKED
}

model Opd {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  category    String   @default("Badan / Dinas Daerah")
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  proposals   Proposal[]

  @@map("opds")
}

model User {
  id          String   @id @default(uuid())
  name        String
  nip         String?  @unique
  email       String   @unique
  password    String
  phone       String?
  role        Role     @default(OPD)
  isActive    Boolean  @default(true)
  opdId       String?
  opd         Opd?     @relation(fields: [opdId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auditLogs              AuditLog[]
  createdProposals       Proposal[]             @relation("UserCreatedProposals")
  verifications          AdminVerification[]    @relation("AdminVerifications")
  proposalRevisions      ProposalRevision[]     @relation("UserRevisions")
  scorings               ProposalScoring[]      @relation("EvaluatorScorings")
  kepalaApprovals        KepalaApproval[]       @relation("KepalaApprovals")
  createdStudies         ResearchStudy[]        @relation("UserCreatedStudies")
  createdRecommendations PolicyRecommendation[] @relation("UserCreatedRecommendations")
  signedRecommendations  PolicyRecommendation[] @relation("KepalaSignedRecommendations")
  digitalSignatures      DigitalSignatureLog[]  @relation("SignerDigitalSignatures")
  followUps              ProposalFollowUp[]     @relation("UserFollowUps")

  @@map("users")
}

model Proposal {
  id               String          @id @default(uuid())
  code             String          @unique
  title            String
  category         String
  problemStatement String          @db.Text
  urgencyReason    String          @db.Text
  urgencyLevel     ProposalUrgency @default(TINGGI)
  expectedOutput   ExpectedOutput  @default(REKOMENDASI_KEBIJAKAN)
  estimatedBudget  Decimal?        @db.Decimal(18, 2)
  status           ProposalStatus  @default(DRAFT)
  submittedAt      DateTime?

  opdId            String
  opd              Opd             @relation(fields: [opdId], references: [id], onDelete: Cascade)

  createdById      String
  createdBy        User            @relation("UserCreatedProposals", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  supportingDocuments ProposalDocument[]
  adminVerification   AdminVerification?
  revisions           ProposalRevision[]
  scoring             ProposalScoring?
  kepalaApproval      KepalaApproval?
  researchStudy       ResearchStudy?
  followUp            ProposalFollowUp?

  @@index([status])
  @@index([opdId])
  @@index([createdById])
  @@index([createdAt])
  @@map("proposals")
}

model ProposalDocument {
  id           String   @id @default(uuid())
  proposalId   String
  proposal     Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  name         String
  size         String
  fileUrl      String?
  uploadDate   DateTime @default(now())

  @@index([proposalId])
  @@map("proposal_documents")
}

model AdminVerification {
  id                String               @id @default(uuid())
  proposalId        String               @unique
  proposal          Proposal             @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  isProblemClear    Boolean              @default(true)
  isUrgencyRelevant Boolean              @default(true)
  isBudgetFeasible  Boolean              @default(true)
  isDataAdequate    Boolean              @default(true)
  
  decision          VerificationDecision @default(PASS)
  verificationNotes String               @db.Text

  verifiedById      String
  verifiedBy        User                 @relation("AdminVerifications", fields: [verifiedById], references: [id], onDelete: Cascade)
  verifiedAt        DateTime             @default(now())

  @@map("admin_verifications")
}

model ProposalRevision {
  id            String   @id @default(uuid())
  proposalId    String
  proposal      Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  revisionNotes String   @db.Text
  returnedById  String
  returnedBy    User     @relation("UserRevisions", fields: [returnedById], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@index([proposalId])
  @@map("proposal_revisions")
}

model ProposalScoring {
  id                     String           @id @default(uuid())
  proposalId             String           @unique
  proposal               Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  // 4 Kriteria Pembobotan Digital (0 - 100)
  visionAlignmentScore   Float            // Bobot: 30%
  urgencyScore           Float            // Bobot: 30%
  budgetFeasibilityScore Float            // Bobot: 20%
  dataReadinessScore     Float            // Bobot: 20%
  totalWeightedScore     Float            // Total Skor Tertimbang (0 - 100)

  // Klasifikasi & Skema
  researchField          ResearchField    @default(EKONOMI_PEMBANGUNAN)
  executionScheme        ExecutionScheme  @default(SWAKELOLA)
  priorityCategory       PriorityCategory @default(PRIORITAS_UTAMA)

  evaluationNotes        String           @db.Text

  evaluatorId            String
  evaluator              User             @relation("EvaluatorScorings", fields: [evaluatorId], references: [id], onDelete: Cascade)
  evaluatedAt            DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@map("proposal_scorings")
}

model KepalaApproval {
  id                   String           @id @default(uuid())
  proposalId           String           @unique
  proposal             Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  decision             ApprovalDecision @default(APPROVED)
  approvedBudget       Decimal?         @db.Decimal(18, 2)
  fiscalYear           Int?
  finalExecutionScheme ExecutionScheme?
  notes                String?          @db.Text

  approvedById         String
  approvedBy           User             @relation("KepalaApprovals", fields: [approvedById], references: [id], onDelete: Cascade)
  approvedAt           DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("kepala_approvals")
}

model ResearchStudy {
  id              String          @id @default(uuid())
  proposalId      String          @unique
  proposal        Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  title           String
  fiscalYear      Int
  allocatedBudget Decimal         @db.Decimal(18, 2)
  executionScheme ExecutionScheme @default(SWAKELOLA)
  
  startDate       DateTime?
  endDate         DateTime?
  status          StudyStatus     @default(PLANNING)

  createdById     String
  createdBy       User            @relation("UserCreatedStudies", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  kakDocument           KakDocument?
  rkaItems              RkaItem[]
  teamMembers           ResearchTeamMember[]
  policyRecommendations PolicyRecommendation[]

  @@index([status])
  @@index([fiscalYear])
  @@map("research_studies")
}

model KakDocument {
  id                  String         @id @default(uuid())
  studyId             String         @unique
  study               ResearchStudy  @relation(fields: [studyId], references: [id], onDelete: Cascade)

  background          String         @db.Text
  objectives          String         @db.Text
  scopeAndMethodology String         @db.Text
  targetOutput        String         @db.Text
  durationMonths      Int            @default(3)
  
  status              DocumentStatus @default(DRAFT)
  finalizedAt         DateTime?
  updatedAt           DateTime       @updatedAt

  @@map("kak_documents")
}

model RkaItem {
  id          String        @id @default(uuid())
  studyId     String
  study       ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  category    String        // e.g. Honorarium, Belanja Operasional, FGD, Pelaporan
  description String
  volume      Float
  unit        String        // e.g. OH, Paket, Bulan, Orang
  unitPrice   Decimal       @db.Decimal(18, 2)
  totalPrice  Decimal       @db.Decimal(18, 2)
  createdAt   DateTime      @default(now())

  @@index([studyId])
  @@map("rka_items")
}

model ResearchTeamMember {
  id          String        @id @default(uuid())
  studyId     String
  study       ResearchStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  name        String
  role        String        // e.g. Ketua Tim Peneliti, Tenaga Ahli Utama, Peneliti Anggota, Surveyor
  institution String        // e.g. BRIDA Mimika, Pusat Studi UGM, UNY
  phone       String?
  email       String?
  createdAt   DateTime      @default(now())

  @@index([studyId])
  @@map("research_team_members")
}

model PolicyRecommendation {
  id               String               @id @default(uuid())
  code             String               @unique // Auto: REK-YYYY-XXX
  studyId          String
  study            ResearchStudy        @relation(fields: [studyId], references: [id], onDelete: Cascade)

  title            String
  executiveSummary String               @db.Text
  keyFindings      String               @db.Text
  policyActions    String               @db.Text
  targetPolicyType PolicyTargetType     @default(DRAFT_PERBUP)
  impactLevel      RecommendationImpact @default(STRATEGIS_DAERAH)
  targetOpdNames   String?              // e.g. "Dinas Pariwisata, Bappeda, Dinas Kebudayaan"
  status           RecommendationStatus @default(DRAFT)
  documentUrl      String?

  createdById      String
  createdBy        User                 @relation("UserCreatedRecommendations", fields: [createdById], references: [id], onDelete: Cascade)

  signedById       String?
  signedBy         User?                @relation("KepalaSignedRecommendations", fields: [signedById], references: [id], onDelete: SetNull)
  signedAt         DateTime?

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status])
  @@index([studyId])
  @@index([impactLevel])
  @@map("policy_recommendations")
}

model DigitalSignatureLog {
  id                String             @id @default(uuid())
  certificateNumber String             @unique // e.g. DS-2026-0001
  documentType      SignedDocumentType
  documentId        String
  documentTitle     String
  documentCode      String?
  
  signerId          String
  signer            User               @relation("SignerDigitalSignatures", fields: [signerId], references: [id], onDelete: Cascade)
  signerName        String
  signerNip         String?
  signerRole        String             @default("Kepala BRIDA")

  signatureHash     String             // SHA-256 Hash Digest
  verificationUrl   String
  status            TteStatus          @default(VALID)
  notes             String?            @db.Text

  signedAt          DateTime           @default(now())

  @@index([certificateNumber])
  @@index([documentType, documentId])
  @@index([signerId])
  @@map("digital_signature_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model ProposalFollowUp {
  id                 String   @id @default(uuid())
  proposalId         String   @unique
  proposal           Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  utilizationType    String   // 'Rencana Kerja (Renja)' | 'Revisi / Pembuatan SOP' | 'Penyusunan Ranperda' | 'Implementasi Teknis'
  utilizationSummary String   @db.Text
  satisfactionRating Int      @default(5)
  feedbackNotes      String?  @db.Text
  submittedById      String
  submittedBy        User     @relation("UserFollowUps", fields: [submittedById], references: [id], onDelete: Cascade)
  submittedAt        DateTime @default(now())

  @@index([proposalId])
  @@index([submittedById])
  @@map("proposal_follow_ups")
}
