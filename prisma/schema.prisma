// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OPD
  BRIDA
  KEPALA_BRIDA
  // MITRA role dihapus — digantikan dengan mekanisme E-Katalog
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(OPD)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  problems  Problem[] @relation("CreatedBy")
}

enum ProblemStatus {
  DRAFT
  SUBMITTED
  PROBLEM_SUBMITTED
  RESEARCH_APPROVED
  KAK_SUBMITTED
  VALID
  ADMINISTRATIVE_REVIEW
  REVISION_REQUIRED
  SUBSTANTIVE_REVIEW
  SCORING
  SELECTION_RECOMMENDED
  APPROVED
  REJECTED
  RESERVE
  EKATALOG_SENT
  OPD_IMPLEMENTING
  OPD_REPORTED
  POLICY_BRIEF_DRAFT
  POLICY_BRIEF_REVIEW
  RECOMMENDATION_PENDING
  RECOMMENDATION_APPROVED
  FOLLOW_UP_PENDING
  FOLLOW_UP_IN_PROGRESS
  FOLLOW_UP_COMPLETED
}

model MasterSector {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  problems    Problem[]
}

model Problem {
  id               String        @id @default(uuid())
  title            String
  sectorId         String
  sector           MasterSector  @relation(fields: [sectorId], references: [id])
  targetCompletion String
  background       String
  mainFocus        String
  impact           String
  urgency          String
  attachments      String[]
  status           ProblemStatus @default(PROBLEM_SUBMITTED)
  progress         Int           @default(0)
  reviewNotes      String?
  createdById      String
  createdBy        User          @relation("CreatedBy", fields: [createdById], references: [id])
  // E-Katalog fields (menggantikan assignedMitra)
  eKatalogUrl      String?
  eKatalogDesc     String?
  eKatalogSentAt   DateTime?
  eKatalogDeadline DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  research         Research?
  opdReports       OpdReport[]
  opdMonitoringLogs OpdMonitoringLog[]
  timeline          Json?
  verificationChecklist Json?
  substantiveReview     Json?
  policyBrief           Json?
  recommendation        Json?
  followUp              Json?
}

model MasterResearchType {
  id         String     @id @default(uuid())
  name       String     @unique
  researches Research[]
}

model Research {
  id                      String             @id @default(uuid())
  problemId               String             @unique
  problem                 Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  title                   String
  researchTypeId          String
  researchType            MasterResearchType @relation(fields: [researchTypeId], references: [id])
  objective               String
  researchQuestions       String
  scope                   String
  expectedOutput          String
  expectedOutcome         String
  successIndicators       String
  estimatedBudget         Float
  estimatedDurationMonths Int
  createdById             String
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  kak                     Kak?
}

model Kak {
  id                String    @id @default(uuid())
  researchId        String    @unique
  research          Research  @relation(fields: [researchId], references: [id], onDelete: Cascade)
  dasarPemikiran    String
  maksudTujuan      String
  ruangLingkup      String
  metodologi        String
  output            String
  outcome           String
  indikatorKinerja  String
  jadwalPelaksanaan String
  penutup           String
  rabItems          RabItem[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model RabItem {
  id          String @id @default(uuid())
  kakId       String
  kak         Kak    @relation(fields: [kakId], references: [id], onDelete: Cascade)
  description String
  volume      Int
  unit        String
  unitPrice   Float
  total       Float
}

// --- Model baru: Laporan Monitoring Berkala OPD ---
model OpdMonitoringLog {
  id          String   @id @default(uuid())
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  progress    Int      // 0–100 persen
  description String
  evidenceFile String?
  createdAt   DateTime @default(now())
}

// --- Model baru: Laporan Akhir OPD ---
model OpdReport {
  id              String   @id @default(uuid())
  problemId       String
  problem         Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  title           String
  findings        String
  obstacles       String
  opdRecommendation String
  attachments     String[]
  submittedAt     DateTime @default(now())
  reviewNotes     String?
  isApproved      Boolean  @default(false)
}
